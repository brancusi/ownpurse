#!/usr/bin/env bash
# The admin (admin/): a UIx app ownpurse serves at /admin, over whatever record it runs on.
#
#   bin/admin dev      builds on save (ClojureScript and Tailwind); a save shows in the open page, state kept
#   bin/admin build    a release build, once: what a workspace needs before (go) serves /admin
#   bin/admin check    compiles it, warnings as errors
#
# Then open http://127.0.0.1:7070/admin/ (or the workspace's own port). The first run installs its npm packages.
set -euo pipefail
cd "$(dirname "$0")/../admin"
[ -d node_modules ] || npm install --no-fund --no-audit
case "${1:-}" in
  dev) exec npm run dev ;;
  build) exec npm run build ;;
  check) exec npx shadow-cljs compile app --config-merge '{:compiler-options {:warnings-as-errors true}}' ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
