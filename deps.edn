{:aliases
 {;; The development project: every brick's sources plus development/src. The REPL runs on this classpath.
  :dev {:extra-paths ["development/src"]
        :extra-deps {org.clojure/clojure {:mvn/version "1.12.6"}
                     party.donut/system {:mvn/version "1.0.259"}
                     org.clojure/tools.namespace {:mvn/version "1.5.1"}}}

  :test {:extra-paths []
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; One long-lived REPL for people and agents: clojure -M:dev:test:nrepl (writes .nrepl-port)
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                       cider/cider-nrepl {:mvn/version "0.63.1"}}
          :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}

  :poly {:main-opts ["-m" "polylith.clj.core.poly-cli.core"]
         :extra-deps {polylith/clj-poly {:mvn/version "0.3.33"}}}}}
