{:aliases
 {;; The development project: every brick's sources plus development/src. The REPL runs on this classpath.
  :dev {:extra-paths ["development/src"]
        :extra-deps {org.clojure/clojure {:mvn/version "1.12.6"}
                     org.clojure/tools.namespace {:mvn/version "1.5.1"}
                     ;; Tests on save at the REPL: (dev/watch)
                     com.nextjournal/beholder {:mvn/version "1.0.2"}

                     poly/config {:local/root "components/config"}
                     poly/json {:local/root "components/json"}
                     poly/ledger {:local/root "components/ledger"}
                     poly/money {:local/root "components/money"}
                     poly/schema {:local/root "components/schema"}
                     poly/store {:local/root "components/store"}
                     poly/xero {:local/root "components/xero"}

                     poly/api {:local/root "bases/api"}}
        ;; What XTDB needs to run in-process (Arrow's off-heap memory and native access).
        :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"
                   "-Dio.netty.tryReflectionSetAccessible=true"
                   "-XX:-OmitStackTraceInFastThrow"]}

  :test {:extra-paths ["components/config/test"
                       "components/json/test"
                       "components/ledger/test"
                       "components/money/test"
                       "components/schema/test"
                       "components/store/test"
                       "components/xero/test"
                       "bases/api/test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; The test run: clojure -M:dev:test:kaocha (tests.edn)
  :kaocha {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
           :main-opts ["-m" "kaocha.runner"]}

  ;; One long-lived REPL for people and agents: clojure -M:dev:test:nrepl (writes .nrepl-port)
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                       cider/cider-nrepl {:mvn/version "0.63.1"}}
          :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}

  :poly {:main-opts ["-m" "polylith.clj.core.poly-cli.core"]
         :extra-deps {polylith/clj-poly {:mvn/version "0.3.33"}}}}}
