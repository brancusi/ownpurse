;; The configuration of a running ownpurse, read with Aero. The profile is :dev at the REPL, :test in tests and
;; :prod in the server. Environment variables (OWNPURSE_*) override the defaults.
{:store {:mode #profile {:test :in-memory
                         :default :disk}
         ;; Where the record lives on disk. Never commit it.
         :dir #or [#env OWNPURSE_DATA_DIR "data"]
         ;; The read-only SQL port (Postgres wire protocol) for DataGrip, psql and other clients. Off in tests.
         :sql #profile {:test nil
                        :default {:host "127.0.0.1"
                                  :read-only-port #long #or [#env OWNPURSE_SQL_PORT 5433]}}}
 ;; Which orgs to read is in a local file that is never committed (their ids are private):
 ;; {:xero {:orgs [{:tenant "<tenant id>" :name "<a name for you>"}]}
 ;;  :mercury {:orgs [{:alias "<mercury-cli alias>" :name "<a name for you>"}] :window-days 60}
 ;;  :plaid {:items [{:alias "<plaid-reader alias>" :name "<a name for you>"}]}}
 ;; Xero's reports: {:xero {:reports {:months 13 :refresh 2}}} keeps 13 months, the latest 2 fetched on every pull.
 ;; Documents' history and attachments: {:xero {:history {:calls 100}}} spends at most 100 calls a pull on them;
 ;; {:files 20} in it also downloads up to 20 attachments' files a pull, into the data directory, and
 ;; {:first {:from "2025-01-01" :to "2025-12-31"}} fetches the documents dated in that range before the rest.
 ;; {:recheck {:days 90 :every 7}} in it looks again, with the calls left over, at the documents dated in the last 90
 ;; days not looked at for 7: Xero can add a note or a receipt without changing a document's version.
 :local #or [#env OWNPURSE_LOCAL_CONFIG "config.local.edn"]
 ;; Xero is read through xero-cli, Mercury through mercury-cli, banks through Plaid by plaid-reader.
 :xero {:cli #or [#env OWNPURSE_XERO_CLI "xero-cli"]}
 :mercury {:cli #or [#env OWNPURSE_MERCURY_CLI "mercury-cli"]}
 :plaid {:cli #or [#env OWNPURSE_PLAID_CLI "plaid-reader"]}
 ;; Secrets live outside every repository, in a file only you can read (chmod 600):
 ;; {:typesafe {:api-key "<your TypeSafe API key>"}}
 ;; A missing file is no error: what needs a secret says so when it is used.
 :secrets #profile {:test {}
                     :default #include #or [#env OWNPURSE_SECRETS
                                            #join [#env HOME "/.config/ownpurse/secrets.edn"]]}
 ;; Jev, TypeSafe's System One model, judges how a bank line is coded (the classify component). The key comes from
 ;; TYPESAFE_API_KEY, else from the secrets file's [:typesafe :api-key]. Tests never have one.
 :jev {:url #or [#env OWNPURSE_JEV_URL "https://api.typesafe.ai"]
       :model #or [#env OWNPURSE_JEV_MODEL "jev-latest"]
       :api-key #profile {:test nil
                          :default #env TYPESAFE_API_KEY}}
 :http {:host "127.0.0.1"
        :port #profile {:test 0
                        :default #long #or [#env OWNPURSE_PORT 7070]}}}
