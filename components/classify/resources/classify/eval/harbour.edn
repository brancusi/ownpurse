         {:id "c09" :date "2025-06-11" :card "card-t" :merchant "Casa Gaivota Apartments" :mcc "7011" :amount 2400.00M :currency "EUR" :country "Portugal" :channel :online :expect :project-cost}
         {:id "c10" :date "2025-05-20" :card "card-t" :merchant "Atlantic Wing Airways" :mcc "4511" :amount 1180.00M :currency "USD" :country "Portugal" :channel :online :note "Home to the project city, departing 10 June" :expect :project-cost
          :why "booked from home before the trip"}
         {:id "c11" :date "2025-08-12" :card "card-t" :merchant "Obra e Casa" :mcc "5200" :amount 310.00M :currency "EUR" :country "Portugal" :channel :in-store :note "plywood and fixings for the installation" :expect :project-cost}
         {:id "c12" :date "2025-08-14" :card "card-r" :merchant "Obra e Casa" :mcc "5200" :amount 46.00M :currency "EUR" :country "Portugal" :channel :in-store :expect :project-cost :ok #{:needs-person}
