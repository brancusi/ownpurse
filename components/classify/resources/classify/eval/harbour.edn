;; The classification eval: an invented group running a project abroad, its atomic rules, and bank lines with the
;; coding a bookkeeper would give each. Everything here is made up. Add a case whenever a real-world line is coded
;; wrongly (in general terms), and keep each rule one sentence that says one thing.
{:scenario "harbour"
 :home "United States"
 ;; The entity whose ordinary running costs are "business".
 :business "tallowmere"

 :entities {"tallowmere" {:name "Tallowmere Studio" :kind :business}
            "lantern" {:name "Lantern Fund" :kind :nonprofit}
            "robin" {:name "Robin" :kind :household}
            "sol" {:name "Sol" :kind :household}}

 :cards {"card-r" {:holder "robin" :entity "robin" :name "Robin's personal card"}
         "card-s" {:holder "sol" :entity "sol" :name "Sol's personal card"}
         "card-t" {:holder "robin" :entity "tallowmere" :name "Tallowmere Studio's business card"}
         "acct-r" {:holder "robin" :entity "robin" :name "Robin's bank account"}}

 ;; :bears is the entity that bears the project's costs: a project cost paid on anyone else's card was paid on its
 ;; behalf. :work is what the project makes, which Jev reads to judge whether an item is for it.
 :projects {"harbour" {:name "Harbour Exhibition"
                       :from "2025-05-01" :to "2025-12-31"
                       :place "Portugal"
                       :work "fabricating plaster sculptures for the exhibition"
                       :bears "tallowmere"
                       :entities ["tallowmere" "lantern"]
                       :travellers ["robin" "sol"]}}

 ;; Where each person was, by day. Derived from the lines in time; written by hand here.
 :trips [{:person "robin" :place "Portugal" :from "2025-06-10" :to "2025-07-20" :project "harbour"}
         {:person "robin" :place "Portugal" :from "2025-08-05" :to "2025-09-30" :project "harbour"}
         {:person "robin" :place "Spain" :from "2025-11-10" :to "2025-11-17"}
         {:person "sol" :place "Portugal" :from "2025-06-15" :to "2025-09-15" :project "harbour"}]

 ;; Merchant category codes (ISO 18245): a lookup, not a judgment.
 :categories {"0742" "Veterinary services"
              "4112" "Passenger railways"
              "4121" "Taxis and rideshare"
              "4215" "Courier services"
              "4511" "Airlines"
              "4722" "Travel agencies and booking sites"
              "4899" "Cable and streaming services"
              "5200" "Home supply and hardware stores"
              "5411" "Grocery stores and supermarkets"
              "5734" "Computer software stores"
              "5812" "Restaurants"
              "5814" "Fast food and cafés"
              "5912" "Pharmacies"
              "5970" "Artist's supply and craft shops"
              "5995" "Pet shops"
              "5999" "Miscellaneous retail"
              "6011" "Cash withdrawal (ATM)"
              "7011" "Hotels and lodging"
              "7299" "Miscellaneous services"
              "7997" "Gyms and clubs"}

 ;; How a line can be coded. The project's own defaults (which entity bears a project cost, the per diem's rate) are
 ;; applied after, in code.
 :codes {:per-diem "A living cost of a project traveller while on a project trip (food, groceries, restaurants, cafés, gym, pet care, pharmacy and other small incidentals), covered by the traveller's per diem"
         :project-cost "A cost of the project itself: its travel, transport and lodging, its venue, materials, equipment, shipping and events"
         :business "An ordinary running cost of the studio's business, not tied to the project"
         :personal "Personal spend that no per diem or business covers"
         :needs-person "The rules do not decide this line, or the facts contradict each other: a person must look at it"}

 ;; Atomic rules: one sentence, one idea. :rule is what a person said; :code is what the rule says when it applies;
 ;; :when is the same rule as building blocks, every one of which must hold:
 ;;   [:is :merchant "x"] [:contains :merchant "x"] (case ignored; also :note)
 ;;   [:amount :between 10.00M 50.00M] [:amount :over 500.00M] [:amount :under 20.00M]
 ;;   [:category :in #{"5411"}] [:card :in #{"card-t"}] [:channel :in #{:online}]
 ;;   [:trip :project] [:trip :personal] [:trip :any] [:at-home] [:during-project] [:country-mismatch]
 ;;   [:traveller] (the cardholder travels for a running project); [:contains :item "x"] (an item of a receipt)
 ;;   [:not block] [:any block ...]
 ;;   [:jev "a yes/no question"]: the fuzzy block, a Noul Jev answers about the line
 ;; A :check rule only ever stops a line for a person, and wins over every other rule. :over names the rules a rule is
 ;; the exception to: when both apply, it decides. Rules that apply and disagree otherwise send the line to a person.
 :rules [{:id "R1" :code :per-diem
          :rule "While a traveller is on a project trip, their food, groceries, restaurants and cafés are covered by their per diem."
          :when [[:trip :project] [:category :in #{"5411" "5812" "5814"}]]}
         {:id "R2" :code :per-diem
          :rule "While a traveller is on a project trip, their gym, pet care and pharmacy purchases are covered by their per diem."
          :when [[:trip :project] [:category :in #{"7997" "0742" "5995" "5912"}]]}
         {:id "R3" :code :project-cost
          :rule "Transport, flights, trains, taxis and lodging for a traveller on a project trip are project costs."
          :when [[:trip :project] [:category :in #{"4112" "4121" "4511" "7011" "4722"}]]}
         {:id "R4" :code :project-cost
          :rule "A flight or lodging booked before a project trip, for that trip, is a project cost."
          :when [[:not [:trip :any]] [:during-project] [:category :in #{"4511" "7011" "4722"}]
                 [:jev "Was this flight or lodging booked for a trip to the project's place?"]]}
         {:id "R5" :code :project-cost
          :rule "Materials, equipment, venue hire, shipping and event catering for the project are project costs, whoever's card paid."
          :when [[:during-project]
                 [:jev "Is this purchase materials, equipment, venue hire, shipping or event catering for the project, rather than something for a person's own use?"]]}
         {:id "R6" :code :personal
          :rule "Food, groceries, gym and pet care while the person is at home are personal, even while a project is running."
          :when [[:at-home] [:category :in #{"5411" "5812" "5814" "7997" "0742" "5995"}]]}
         {:id "R7" :code :business
          :rule "Software subscriptions and online tools for the studio are ordinary business costs, wherever the person is."
          :when [[:any [:category :in #{"5734"}]
                  [:jev "Is this a software subscription or online tool used for a creative studio's work?"]]]}
         {:id "R8" :code :needs-person :check true
          :rule "Cash withdrawals and transfers between our own people or accounts are never coded automatically."
          :when [[:any [:category :in #{"6011"}] [:channel :in #{:transfer}]]]}
         {:id "R9" :code :personal
          :rule "Spending on a personal holiday, outside any project trip, is personal."
          :when [[:trip :personal]]}
         {:id "R10" :code :needs-person :check true
          :rule "A purchase made in person in a country where the cardholder is not recorded to be is never coded automatically."
          :when [[:channel :in #{:in-store}] [:country-mismatch]]}
         {:id "R11" :code :project-cost :over ["R1" "R2" "R6"]
          :rule "Plaster, sandpaper, drill bits and other materials, tools and consumables for fabricating the sculptures, bought by a project traveller while the project runs, are project costs whatever the shop and whoever's card paid, even at a grocery store or a pharmacy."
          :when [[:traveller]
                 [:any [:contains :item "plaster"] [:contains :item "sandpaper"] [:contains :item "drill bit"]
                  [:jev "Is this item a material, tool or consumable used in fabricating plaster sculptures?"]]]}]

