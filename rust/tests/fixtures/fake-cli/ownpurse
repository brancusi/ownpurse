#!/bin/sh
# A fake `ownpurse` for the TUI's sync/login tests: no network. It replays the real CLI's `--progress jsonl`
# events on stderr and its `--json` envelope on stdout, per scenario, with the real CLI's texts (copied from
# ownpurse-xero / ownpurse-cli; never invented). When given a record COPY it also appends the rows the real
# run writes, through `ownpurse-fake-record` (ownpurse-xero's Writer: append-only tables, intact chain).
#
#   OWNPURSE_FAKE_SCENARIO  ok | all | limit | error | slow | wait | login        (default ok)
#   OWNPURSE_FAKE_ARGV      append this run's argv (one argument per line, then a blank line) to that file
#   OWNPURSE_FAKE_MARKER    write "done <scenario>" to that file when the run completes
#   OWNPURSE_FAKE_DELAY     seconds between events (default 0.05; slow uses 0.3)
#   OWNPURSE_FAKE_LEFT      the org's calls left before the run, as last reported (default 938)
#   OWNPURSE_FAKE_RECORD    a record copy (under the temp folder) to append the run's rows to (optional)
#   OWNPURSE_FAKE_WRITER    the ownpurse-fake-record binary (needed with OWNPURSE_FAKE_RECORD)
#   OWNPURSE_FAKE_TENANTS   the target's tenant ids, comma-separated (needed with OWNPURSE_FAKE_RECORD)
#   OWNPURSE_FAKE_AT        when the run finishes, YYYY-MM-DDTHH:MM:SSZ (default 2026-10-05T09:46:00Z)
#
# The TUI may quit mid-run: writes to a closed pipe must not kill the run (as the real CLI ignores them).
trap '' PIPE

if [ "$1" = "--version" ]; then
  echo "ownpurse 0.9.0"
  exit 0
fi

if [ -n "$OWNPURSE_FAKE_ARGV" ]; then
  for a in "$@"; do printf '%s\n' "$a" >> "$OWNPURSE_FAKE_ARGV"; done
  printf '\n' >> "$OWNPURSE_FAKE_ARGV"
fi

scenario="${OWNPURSE_FAKE_SCENARIO:-ok}"
delay="${OWNPURSE_FAKE_DELAY:-0.05}"
[ "$scenario" = "slow" ] && delay="${OWNPURSE_FAKE_DELAY:-0.3}"
org="${2:-design}"
left="${OWNPURSE_FAKE_LEFT:-938}"

ev() { printf '%s\n' "$1" >&2 2>/dev/null; [ "$delay" = "0" ] || sleep "$delay"; }
out() { printf '%s\n' "$1" 2>/dev/null; }
finish() {
  [ -n "$OWNPURSE_FAKE_MARKER" ] && printf 'done %s\n' "$scenario" > "$OWNPURSE_FAKE_MARKER"
}
write_rows() {
  if [ -n "$OWNPURSE_FAKE_RECORD" ]; then
    "$OWNPURSE_FAKE_WRITER" "$OWNPURSE_FAKE_RECORD" "$scenario" "$OWNPURSE_FAKE_TENANTS" \
      "${OWNPURSE_FAKE_AT:-2026-10-05T09:46:00Z}" || exit 4
  fi
}

# sync order (ownpurse-xero sync::entities): one call each, BankTransactions over 2 pages
ENTITIES="Organisation: Accounts: TaxRates: TrackingCategories: Currencies: BankTransfers: Contacts:p \
BankTransactions:p BankTransactions:p2 ManualJournals:p Invoices:p CreditNotes:p Payments:p Overpayments:p Prepayments:p"

sync_org() {
  o="$1"; l="$2"; calls=0
  ev "{\"ev\":\"start\",\"org\":\"$o\",\"entities\":14,\"estimate\":15,\"estimate_label\":\"≈ 15 calls\"}"
  for e in $ENTITIES; do
    name="${e%%:*}"; kind="${e#*:}"
    case "$kind" in p) page=1 ;; p2) page=2 ;; *) page=null ;; esac
    calls=$((calls + 1)); l=$((l - 1))
    ev "{\"ev\":\"entity\",\"org\":\"$o\",\"entity\":\"$name\",\"page\":$page,\"calls\":$calls,\"day_remaining\":$l}"
    if [ "$scenario" = "wait" ] && [ "$calls" = 5 ]; then
      ev "{\"ev\":\"wait\",\"org\":\"$o\",\"reason\":\"minute_limit\",\"seconds\":4}"
    fi
  done
}

synced_rows() {
  o="$1"; sep=""
  for e in Organisation:1:1 Accounts:20:1 TaxRates:0:1 TrackingCategories:0:1 Currencies:0:1 BankTransfers:0:1 \
           Contacts:0:1 BankTransactions:4:2 ManualJournals:0:1 Invoices:0:1 CreditNotes:0:1 Payments:0:1 \
           Overpayments:0:1 Prepayments:0:1; do
    name="${e%%:*}"; rest="${e#*:}"; fetched="${rest%%:*}"; calls="${rest#*:}"
    nv=0; [ "$name" = "BankTransactions" ] && nv=3
    printf '%s  {\n   "org": "%s",\n   "entity": "%s",\n   "mode": "full",\n   "fetched": %s,\n   "new_versions": %s,\n   "calls": %s,\n   "vanished": 0\n  }' \
      "$sep" "$o" "$name" "$fetched" "$nv" "$calls"
    sep=",
"
  done
}

ok_envelope() {
  n="$1"; shift
  rows=""; sep=""
  for o in "$@"; do rows="$rows$sep$(synced_rows "$o")"; sep=",
"; done
  out "{
 \"synced\": [
$rows
 ],
 \"synced_count\": $((14 * n)),
 \"calls_used\": $((15 * n)),
 \"help\": [
  \"Run \`ownpurse accounts <org>\`, \`ownpurse txns <org>\` or \`ownpurse tui\` to read the record.\"
 ]
}"
}

case "$scenario" in
  ok|slow|wait)
    sync_org "$org" "$left"
    write_rows
    ev "{\"ev\":\"done\",\"org\":\"$org\",\"calls\":15,\"records\":25,\"new_versions\":3}"
    finish
    ok_envelope 1 "$org"
    exit 0
    ;;
  all)
    for o in roast hold design lab; do
      sync_org "$o" 900
      ev "{\"ev\":\"done\",\"org\":\"$o\",\"calls\":15,\"records\":25,\"new_versions\":3}"
    done
    write_rows
    finish
    ok_envelope 4 roast hold design lab
    exit 0
    ;;
  limit)
    ev "{\"ev\":\"start\",\"org\":\"$org\",\"entities\":14,\"estimate\":15,\"estimate_label\":\"≈ 15 calls\"}"
    ev "{\"ev\":\"entity\",\"org\":\"$org\",\"entity\":\"Organisation\",\"page\":null,\"calls\":1,\"day_remaining\":0}"
    write_rows
    finish
    out '{
 "error": "daily_limit",
 "message": "Xero daily call limit reached for this organisation.",
 "help": [
  "Use cached data (`--offline`).",
  "Xero resets each org'"'"'s daily limit at its own time; `ownpurse usage` shows what'"'"'s left."
 ]
}'
    exit 1
    ;;
  error)
    ev "{\"ev\":\"start\",\"org\":\"$org\",\"entities\":14,\"estimate\":15,\"estimate_label\":\"≈ 15 calls\"}"
    ev "{\"ev\":\"entity\",\"org\":\"$org\",\"entity\":\"Organisation\",\"page\":null,\"calls\":1,\"day_remaining\":null}"
    ev "{\"ev\":\"entity\",\"org\":\"$org\",\"entity\":\"Organisation\",\"page\":null,\"calls\":2,\"day_remaining\":null}"
    write_rows
    finish
    out '{
 "error": "needs_login",
 "message": "Xero rejected the access token.",
 "help": [
  "Run `ownpurse login`."
 ]
}'
    exit 1
    ;;
  login)
    ev "{\"ev\":\"browser\",\"url_shown\":false,\"timeout\":900}"
    ev "{\"ev\":\"done\",\"orgs\":4}"
    finish
    out '{
 "status": "logged_in",
 "scopes": [],
 "orgs": [],
 "orgs_count": 0,
 "help": [
  "Run `ownpurse sync all` to build the local record."
 ]
}'
    exit 0
    ;;
  *)
    printf 'unknown fake scenario %s\n' "$scenario" >&2
    exit 3
    ;;
esac
