.DS_Store
build/
# Local committed-tree export, prepared from the exact pin in caretline.rev
/vendor/caretline/
/vendor/.caretline-export.*/
# never commit credentials or local records
tokens*.json
# the brand's design tokens are not credentials
!brand/tokens.json
*.sqlite
*.sqlite-wal
*.sqlite-shm
/ownpurse.json
# the private denylist (and any hashed form of it) never lives in this repository
denylist
*.denylist
denylist.sha256

# test fixtures are generic, committed test data (see rust/tests/fixtures/*/README.md)
!rust/tests/fixtures/**/*.sqlite
