---
interface Props { size?: number; tone?: 'color' | 'mono' | 'reversed'; state?: 'rest' | 'thinking' | 'minus' | 'plus'; blink?: boolean; title?: string; class?: string }
const { size = 48, tone = 'color', state = 'rest', blink = false, title = 'ownpurse', class: cls } = Astro.props;
---
<svg class:list={['op-mark', tone !== 'color' && tone, cls]} viewBox="12 20 72 64" width={size * 72 / 64} height={size} role="img" aria-label={title}>
	<rect class="fg" x="12" y="20" width="72" height="10" />
	<rect class="fg" x="43" y="30" width="10" height="54" />
	<circle class="eye" cx="28" cy="50" r="9" />
	{state === 'minus' && <rect class="fg" x="59" y="47.75" width="18" height="4.5" />}
	{state === 'plus' && <><rect class="fg" x="59" y="47.75" width="18" height="4.5" /><rect class="fg" x="65.75" y="41" width="4.5" height="18" /></>}
	{state === 'thinking' && <ellipse class="fgs" cx="68" cy="50" rx="7" ry="2.6" fill="none" stroke-width="4" />}
	{state === 'rest' && <circle class:list={['fgs', blink && 'op-blink']} cx="68" cy="50" r="7" fill="none" stroke-width="4" />}
</svg>
