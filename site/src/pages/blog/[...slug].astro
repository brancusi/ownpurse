---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
	const posts = await getCollection('blog', (p) => !p.data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} · ownpurse`} description={post.data.description} current="blog">
<article class="wrap" style="padding-block: 72px 96px;">
	<header class="stack" style="max-width: 42rem; margin-bottom: 40px;">
		<a class="eyebrow" href="/blog/" style="text-decoration: none;">Blog</a>
		<h1 class="h1 sm" style="font-size: clamp(36px, 4.6vw, 60px);">{post.data.title}</h1>
		<p class="lead">{post.data.description}</p>
		<p class="small muted"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time> · {post.data.author}</p>
	</header>
	<div class="prose"><Content /></div>
	<footer style="max-width: 42rem; margin-top: 56px; border-top: 1px solid var(--line-1); padding-top: 20px;" class="row">
		<a href="/blog/" style="font-weight: 600;">All posts</a><span class="muted">·</span><a href="/rss.xml" style="font-weight: 600;">RSS</a>
	</footer>
</article>
</Base>
